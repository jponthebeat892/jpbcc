{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The two authorized operators of this channel"
    },
    "participant_handles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "key_code": {
      "type": "string",
      "description": "Long term channel key issued to both operators - readable only by them"
    },
    "key_fingerprint": {
      "type": "string"
    },
    "request_id": {
      "type": "string"
    },
    "last_message_at": {
      "type": "string"
    },
    "last_preview": {
      "type": "string"
    },
    "message_count": {
      "type": "number"
    }
  },
  "required": [
    "participants",
    "key_code"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.participants": {
            "$in": [
              "{{user.id}}"
            ]
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "update": {
      "data.participants": {
        "$in": [
          "{{user.id}}"
        ]
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}